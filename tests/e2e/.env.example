# The XNAT instance under test. Must be running a structured importer build
# from the develop branch; global setup checks this and fails the run if the
# configuration API is missing.
XNAT_URL=https://xnat.example.org

# A site administrator account.
ADMIN_USER=admin
ADMIN_PASS=

# An existing, enabled, NON site-admin account. The permissions specs use it to
# confirm the configuration API is gated. It needs no project membership; one
# of the specs relies on it having no access to a project the admin creates.
# Leaving it unset skips the permissions project and runs everything else.
NON_ADMIN_USER=
NON_ADMIN_PASS=

# Which branch of the plugin is deployed. Defaults to develop, which is where
# the plugin's current work lives and where the configuration REST API exists.
# Set to main only after that work merges, or to run importer-only coverage
# against a pre-merge main build.
TARGET_BRANCH=develop

# Optional. By default each spec file creates a uniquely named project and
# deletes it afterwards. Set this to run against an existing project instead,
# for an account that cannot create projects. The suite then deletes only the
# sessions it created and leaves the project alone.
TEST_PROJECT=
